<Window x:Class="OutilGestionAbsences.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OutilGestionAbsences"
        mc:Ignorable="d"
        Title="Gestion des Absences" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <Button Content="Ajouter un nouvel étudiant" Padding="10" Margin="20" Click="AddStudent_Click" />
            <Button Content="Importer des étudiants" Padding="10" Margin="20" Click="ImportData_Click" />
            <Button Content="Ajouter des absences" Padding="10" Margin="20" Click="AddAbsence_Click" />
            <Button Content="Résumé des absences" Padding="10" Margin="20" Click="ResumeAbsences_Click" />
        </StackPanel>
        <ListBox Grid.Column="1" Margin="20" ItemsSource="{Binding Students}"
                 SelectedItem="{Binding SelectedStudent}"
                 MouseDoubleClick="StudentList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding LastName}" FontWeight="Bold"/>
                        <Run Text="{Binding FirstName}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
